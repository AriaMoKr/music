{
  "name": "music",
  "version": "0.2.0",
  "description": "A candle-lit music room for Project Gutenberg's books on music: read them and hear their MIDI scores and recordings play, on a gramophone, a music stand or page by page, in VR (Meta Quest), on a desktop or a phone. A fork of vrlbry.",
  "keywords": ["music", "midi", "synthesizer", "web-audio", "sheet-music", "webxr", "virtual-reality", "threejs", "meta-quest", "kiwix", "zim", "openzim", "project-gutenberg", "wikipedia", "wikisource", "ebook-reader", "digital-library", "offline-first"],
  "homepage": "https://ariamokr.github.io/music/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/music.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/music/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "vrlbry": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:https": "node server/index.js --https",
    "test": "node --test \"test/*.test.js\"",
    "perf:quest": "node tools/quest-perf.mjs",
    "build:pages": "node tools/build-pages.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "htmlparser2": "^12.0.0",
    "layersharedsession": "github:AriaMoKr/layersharedsession#c6420409f1e742a1cfaf30646106812f666bca2b",
    "selfsigned": "^5.5.0",
    "three": "^0.186.1",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "iwer": "^2.5.0"
  }
}
